{
  "name": "pasticceriaos-e2e",
  "private": true,
  "description": "Suite E2E audit bakery↔supplier per PasticceriaOS (Playwright). Self-contained: non tocca i node_modules dell'app.",
  "scripts": {
    "test": "NODE_PATH=./node_modules playwright test --config=../playwright.config.ts",
    "test:list": "NODE_PATH=./node_modules playwright test --config=../playwright.config.ts --list",
    "test:setup": "NODE_PATH=./node_modules playwright test --config=../playwright.config.ts --project=setup",
    "report": "playwright show-report ./artifacts/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}
