# =============================================================================
# PasticceriaOS — .gitignore
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/
build/

# ── Environment files ─────────────────────────────────────────────────────────
# .env.example IS committed (template with placeholders, no secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── TypeScript build artifacts ────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Dev/debug artifacts ───────────────────────────────────────────────────────
# Files used during development but not needed in the repo
_typetest.ts
*.bak
REFACTOR_REPORT.md
TEST_CHECKLIST.md

# ── Legacy scaffold (superseded by active routes) ─────────────────────────────
# Active auth: /login and /signup — these are dead duplicates
app/(auth)/sign-in/
app/(auth)/sign-up/
app/app/
components/cliente/
components/fornitore/
components/forms/
lib/data/

# ── Vercel (not used, but standard exclusion) ─────────────────────────────────
.vercel
