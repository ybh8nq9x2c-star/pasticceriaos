# =============================================================================
# PasticceriaOS — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Railway deployment, set these variables in the Railway dashboard
# under your service → Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Supabase project credentials
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# OPTIONAL — Only needed for scripts that bypass RLS (e.g. migrations, seeds)
# Never expose in client-side code or commit to version control.
# Set only in a secure local environment or Railway private variable.
# -----------------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# OPTIONAL — Application URL (used for redirects, OAuth callbacks)
# In Railway this is set automatically via RAILWAY_STATIC_URL.
# In local dev, leave unset or set to http://localhost:3000
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
