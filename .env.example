# =============================================================================
# PasticceriaOS — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Railway deployment, set these variables in the Railway dashboard
# under your service → Variables. Checklist completa nel README ("Deploy su
# Railway → Variabili ambiente").
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Supabase project credentials
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# REQUIRED (portale fornitore) — chiave HS256 per firmare i link del portale.
# Minimo 32 caratteri. Genera con: openssl rand -hex 32
# Senza questa variabile la generazione dei link portale è disabilitata
# (l'app mostra un errore chiaro, il resto continua a funzionare).
# RUOTARE in produzione = revocare tutti i link emessi.
# -----------------------------------------------------------------------------

SUPPLIER_TOKEN_SECRET=generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# REQUIRED (portale fornitore + storage documenti) — service role Supabase.
# Solo server-side (lib/supabase/admin.ts): mai esposta al client.
# Senza questa chiave il portale fornitore risponde "non configurato".
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# OPTIONAL — Integrazione POS (webhook cassa → magazzino, R7).
# MIPOS_WEBHOOK_SECRET: segreto HMAC-SHA256 per verificare i webhook MiPOS
# (POST /api/webhooks/mipos). Senza, ogni webhook MiPOS viene rifiutato (401).
# Richiede anche SUPABASE_SERVICE_ROLE_KEY (sopra) e una riga in pos_configs
# (provider+store_id|merchant_code → organization_id) per risolvere l'org.
# -----------------------------------------------------------------------------

# MIPOS_WEBHOOK_SECRET=your-mipos-webhook-secret-here

# -----------------------------------------------------------------------------
# OPTIONAL — Application URL (redirect OAuth e URL assoluti dei link portale).
# In produzione impostarla all'URL pubblico (es. https://your-app.up.railway.app):
# senza, i link del portale vengono generati su http://localhost:3000.
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# -----------------------------------------------------------------------------
# OPTIONAL — Storage bucket per i documenti commerciali (default consigliato).
# -----------------------------------------------------------------------------

# SUPABASE_STORAGE_BUCKET=commercial-documents

# -----------------------------------------------------------------------------
# OPTIONAL — Cron alert scadenze (edge function expiry-alerts).
# Stesso valore va nei Secrets della Edge Function come CRON_SECRET.
# -----------------------------------------------------------------------------

# CRON_SECRET=generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# OPTIONAL — Import ricette assistito dall'AI (modules/recipe-import/ai).
# Server-side only. SENZA nessuna key la feature è SPENTA: l'import resta
# 100% deterministico (nessun cambiamento di comportamento) e il toggle
# "Assistenza AI" non compare. L'AI è solo preview: niente viene salvato
# senza la conferma dell'utente, gli schemi al commit restano stretti.
#
# Provider auto-selezionato dalla key presente (Gemini ha priorità):
#   • GEMINI_API_KEY    → Gemini (generateContent + structured output)
#   • ANTHROPIC_API_KEY → Claude
# Modello opzionale (default: gemini-2.5-flash per Gemini, claude-opus-4-8 per Claude).
# NON committare mai la chiave reale: impostarla in .env.local / Railway.
# -----------------------------------------------------------------------------

# GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
# RECIPE_IMPORT_AI_MODEL=gemini-2.5-flash
